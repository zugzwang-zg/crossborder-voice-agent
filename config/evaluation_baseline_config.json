{
  "schema_version": "1.7.0",
  "prompt_version": "v1_basic",
  "prompt_path": "prompts/v1_basic_prompt.md",
  "provider": "openai",
  "base_url": "https://api.aijws.com",
  "model": "gpt-5.6-luna",
  "reasoning_effort": "low",
  "text_verbosity": "low",
  "max_output_tokens": 2500,
  "timeout_seconds": 90,
  "max_retries": 5,
  "retry_base_seconds": 2.0,
  "store": false,
  "pricing_usd_per_1m": {
    "input": 1.0,
    "cached_input": 0.1,
    "output": 6.0
  },
  "input_path": "data/evaluation/gold_input_100.csv",
  "output_path": "data/evaluation/baseline_predictions.jsonl",
  "error_path": "data/evaluation/baseline_errors.jsonl",
  "run_log_path": "runs/evaluation_baseline.json"
}
